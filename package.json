{
    "name": "endless-ssh-rs-with-web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "@unovis/react": "1.7.1",
        "@unovis/ts": "1.7.1",
        "country-flag-emoji-polyfill": "0.1.10",
        "ip-address": "10.7.3",
        "maplibre-gl": "6.13.0",
        "nuqs": "2.10.1",
        "pretty-bytes": "7.2.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-map-gl": "8.1.3",
        "recharts": "3.10.1",
        "temporal-polyfill": "1.0.5"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@recharts/devtools": "0.0.18",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/coverage-v8": "5.0.3",
        "@vitest/ui": "5.0.3",
        "cspell": "10.3.6",
        "dependency-cruiser": "18.5.0",
        "eslint-plugin-better-tailwindcss": "4.9.0",
        "eslint-plugin-n": "18.4.1",
        "eslint-plugin-perfectionist": "5.12.1",
        "eslint-plugin-react-hook-form": "0.3.1",
        "husky": "9.1.7",
        "jsdom": "30.1.2",
        "lint-staged": "17.6.0",
        "oxc-transform-react": "0.153.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.0.3"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
