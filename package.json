{
    "name": "endless-ssh-rs-with-web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "country-flag-emoji-polyfill": "0.1.10",
        "ip-address": "10.7.6",
        "maplibre-gl": "6.16.0",
        "nuqs": "2.10.2",
        "pretty-bytes": "7.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-error-boundary": "6.1.6",
        "react-map-gl": "8.1.3",
        "recharts": "3.10.1",
        "temporal-polyfill": "1.0.8"
    },
    "devDependencies": {
        "@codecov/bundle-analyzer": "2.0.1",
        "@codecov/vite-plugin": "2.0.1",
        "@recharts/devtools": "0.0.19",
        "@tailwindcss/vite": "4.3.4",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/ui": "5.1.0",
        "cspell": "10.4.0",
        "dependency-cruiser": "18.7.2",
        "eslint-plugin-better-tailwindcss": "4.10.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-perfectionist": "5.13.0",
        "eslint-plugin-react-hook-form": "0.3.1",
        "husky": "9.1.7",
        "jsdom": "31.0.0",
        "lint-staged": "17.6.0",
        "oxc-transform-react": "0.156.0",
        "oxfmt": "0.76.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "tailwindcss": "4.3.4",
        "tar": "7.5.22",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.1.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.13.0"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
