{
    "name": "endless-ssh-rs-with-web",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "country-flag-emoji-polyfill": "0.1.10",
        "ip-address": "10.5.0",
        "maplibre-gl": "6.6.0",
        "nuqs": "2.10.1",
        "pretty-bytes": "7.1.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-map-gl": "8.1.2",
        "recharts": "3.10.1",
        "temporal-polyfill": "1.0.4"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@recharts/devtools": "0.0.18",
        "@rolldown/plugin-babel": "0.2.3",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/babel__core": "7.20.5",
        "@types/node": "26.3.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.0",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "babel-plugin-react-compiler": "1.0.0",
        "cspell": "10.1.1",
        "dependency-cruiser": "18.2.0",
        "eslint-plugin-better-tailwindcss": "4.7.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-react-hook-form": "0.3.1",
        "eslint-plugin-react-refresh": "0.5.5",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.7.0",
        "pnpm": "11.24.0"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
