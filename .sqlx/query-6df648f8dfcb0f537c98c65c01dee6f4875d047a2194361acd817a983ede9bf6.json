  "query": "\n        SELECT\n            total_connections AS \"total_connections!: i64\"\n            , total_bytes_sent AS \"total_bytes_sent!: i64\"\n            , total_time_spent AS \"total_time_spent!: DbDuration\"\n            , (\n                SELECT\n                    COALESCE(MAX(id), 0)\n                FROM\n                    connections\n            ) AS \"last_counted_id!: i64\"\n        FROM totals\n        WHERE id = 1\n        ",
