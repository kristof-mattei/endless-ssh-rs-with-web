  "query": "\n        UPDATE totals\n        SET\n            total_connections = total_connections + 1\n            , total_bytes_sent = total_bytes_sent + $1\n            , total_time_spent = total_time_spent + $2\n        WHERE id = 1\n        RETURNING\n            total_connections\n            , total_bytes_sent\n            , total_time_spent AS \"total_time_spent: DbDuration\"\n        ",
